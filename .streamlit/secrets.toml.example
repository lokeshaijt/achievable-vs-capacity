# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# app's "Secrets" settings. Never commit the real secrets.toml file.

[smtp]
server = "smtp.gmail.com"
port = 587
username = "your-account@gmail.com"
# Gmail: use a 16-character App Password, not your normal password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
password = "your-app-password"
sender = "your-account@gmail.com"
